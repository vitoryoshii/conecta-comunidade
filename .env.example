# =============================================================================
# Conecta Comunidade - variáveis de ambiente
# Copie este arquivo para `.env` e ajuste os valores.
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
# =============================================================================

# --- Identidade da API -------------------------------------------------------
APP_NOME="Conecta Comunidade API"
APP_VERSAO="1.0.0"
DEBUG=true

# --- Banco de dados ----------------------------------------------------------
# SQLite (desenvolvimento) - caminho relativo à raiz do projeto:
DATABASE_URL="sqlite:///conecta.db"
# PostgreSQL (produção) - basta trocar a linha acima por:
# DATABASE_URL="postgresql+psycopg://usuario:senha@localhost:5432/conecta"

# --- Segurança / JWT ---------------------------------------------------------
# TROQUE esta chave em produção. Gere uma nova com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="troque-esta-chave-em-producao-conecta-comunidade"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS --------------------------------------------------------------------
# "*" libera qualquer origem (conveniente em desenvolvimento).
# Em produção, liste os domínios separados por vírgula.
CORS_ORIGINS="*"

# --- Integração do app mobile ------------------------------------------------
# URL da API usada pelo app Flet.
API_BASE_URL="http://127.0.0.1:8000"
